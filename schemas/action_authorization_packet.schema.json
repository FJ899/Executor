{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creative-os.local/schemas/action_authorization_packet.schema.json",
  "title": "Executor Action Authorization Packet v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_id",
    "run_id",
    "issued_at",
    "expires_at",
    "issuer",
    "bindings",
    "action",
    "decision",
    "constraints",
    "integrity"
  ],
  "properties": {
    "schema_version": {"const": "executor-action-authorization/1.0"},
    "packet_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
    "issued_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "expires_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "id", "evidence_ref"],
      "properties": {
        "role": {"enum": ["USER", "POLICY_VERIFIER"]},
        "id": {"type": "string", "minLength": 1},
        "evidence_ref": {"type": "string", "minLength": 1}
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "risk_class",
        "mode",
        "executor_commit",
        "policy_sha256",
        "project_contract_sha256",
        "task_contract_sha256",
        "test_contract_sha256",
        "repository_commits"
      ],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "risk_class": {"enum": ["LOW_RISK", "MEDIUM_RISK", "HIGH_RISK"]},
        "mode": {"enum": ["PLAN", "BUILD_AND_TEST", "AUDIT"]},
        "executor_commit": {"type": "string", "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"},
        "policy_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "project_contract_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "task_contract_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "test_contract_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "repository_commits": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"}
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "argv", "paths", "network", "secrets", "external_project"],
      "properties": {
        "kind": {
          "enum": [
            "SANDBOX_EXECUTION",
            "WRITE_REPOSITORY",
            "CREATE_PULL_REQUEST",
            "MERGE_PULL_REQUEST",
            "EXTERNAL_PROJECT_EXECUTION"
          ]
        },
        "argv": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "network": {"type": "boolean"},
        "secrets": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "external_project": {"type": "boolean"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reasons"],
      "properties": {
        "status": {"enum": ["AUTHORIZED", "DENIED"]},
        "reasons": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_uses", "max_duration_seconds", "manual_confirmation_required"],
      "properties": {
        "max_uses": {"const": 1},
        "max_duration_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "manual_confirmation_required": {"type": "boolean"}
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "payload_sha256"],
      "properties": {
        "algorithm": {"const": "SHA-256"},
        "payload_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
      }
    }
  }
}
