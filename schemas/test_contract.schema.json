{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "executor-test/1.0",
  "type": "object",
  "required": [
    "schema_version",
    "test_id",
    "source_claims",
    "positive_control",
    "negative_control",
    "tamper_control",
    "unchanged_controls",
    "holdout",
    "acceptance"
  ],
  "properties": {
    "schema_version": {
      "const": "executor-test/1.0"
    },
    "test_id": {
      "type": "string",
      "minLength": 1
    },
    "source_claims": {
      "type": "array",
      "minItems": 1
    },
    "positive_control": {
      "type": "object"
    },
    "negative_control": {
      "type": "object"
    },
    "tamper_control": {
      "type": "object"
    },
    "unchanged_controls": {
      "type": "array",
      "minItems": 1
    },
    "holdout": {
      "type": "object"
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
