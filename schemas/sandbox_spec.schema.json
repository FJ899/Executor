{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/sandbox_spec.schema.json",
  "title": "Executor Sandbox Specification",
  "type": "object",
  "required": [
    "image",
    "command_rules",
    "max_cpu",
    "max_memory_mb",
    "max_disk_mb",
    "timeout_seconds",
    "pids_limit",
    "network",
    "secrets",
    "home_access"
  ],
  "properties": {
    "image": {
      "type": "string",
      "minLength": 1
    },
    "command_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "executable",
          "argv_prefix"
        ],
        "properties": {
          "executable": {
            "type": "string",
            "minLength": 1
          },
          "argv_prefix": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "max_cpu": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "max_memory_mb": {
      "type": "integer",
      "minimum": 32
    },
    "max_disk_mb": {
      "type": "integer",
      "minimum": 1
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "pids_limit": {
      "type": "integer",
      "minimum": 4
    },
    "network": {
      "const": false
    },
    "secrets": {
      "type": "array",
      "maxItems": 0
    },
    "home_access": {
      "const": false
    },
    "source_mount": {
      "type": "string"
    },
    "workspace_mount": {
      "type": "string"
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
